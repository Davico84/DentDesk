# Copia este archivo a `secrets.properties` (ignorado por git) y rellena los valores.
# Lo consume Spring (spring.config.import) y Docker Compose (docker compose --env-file secrets.properties up -d).
# NO subir secrets.properties al repo.

# --- Base de datos ---
# DB_PORT: puerto del host donde se expone el PostgreSQL de compose.
# Si ya tienes un PostgreSQL nativo en 5432, usa otro (p. ej. 5433) y ajusta DB_URL.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/odontorisas
DB_NAME=odontorisas
# Credenciales del rol de APLICACIÓN (runtime). En despliegue debe ser un rol
# SOLO-DML y NO propietario de las tablas, para que Row-Level Security le aplique
# de forma ineludible. NUNCA debe ser SUPERUSER ni tener BYPASSRLS (saltan RLS).
DB_USERNAME=odontorisas
DB_PASSWORD=cambia-esta-clave

# --- Menor privilegio: rol de migraciones (Flyway/DDL, propietario de las tablas) ---
# Opcional. Si se omite, Flyway usa las mismas credenciales de la app (válido para
# desarrollo local con un único usuario). En despliegue define un rol admin separado
# y crea ambos roles con scripts/db-roles.sql.
# DB_ADMIN_USERNAME=odontorisas_admin
# DB_ADMIN_PASSWORD=cambia-esta-clave-admin

# --- Documentación de la API (Swagger) ---
# SWAGGER_ENABLED: apagada por defecto. En LOCAL descomenta la línea de abajo para ver
# /swagger-ui.html y /v3/api-docs. En DESPLIEGUE déjala comentada o ausente: si copias este
# archivo tal cual, la documentación queda apagada.
# SWAGGER_ENABLED=true

# --- Seguridad / JWT ---
# JWT_SECRET: al menos 32 BYTES aleatorios (genera uno con: openssl rand -base64 48).
# La app NO arranca si falta, si es este valor de ejemplo o si tiene menos de 32 bytes.
# Sin openssl (Windows): node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
# Opcionales (tienen defaults en application.yml):
# JWT_ISSUER=odontorisas
# JWT_ACCESS_TTL=PT15M        # Duration ISO-8601 (access token en memoria)
# JWT_REFRESH_TTL=P7D         # Duration ISO-8601 (refresh en cookie httpOnly)
# REFRESH_COOKIE_NAME=refresh_token
# COOKIE_SECURE=true          # false para http en local si es necesario
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Bloqueo por intentos fallidos de login (opcionales, tienen defaults en application.yml) ---
# AUTH_LOCKOUT_MAX_ATTEMPTS=5     # intentos fallidos consecutivos antes de bloquear
# AUTH_LOCKOUT_WINDOW=PT15M       # Duration ISO-8601 (duración del bloqueo)
