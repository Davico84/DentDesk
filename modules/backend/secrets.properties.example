# Copia este archivo a `secrets.properties` (ignorado por git) y rellena los valores.
# Lo consume Spring (spring.config.import) y Docker Compose (docker compose --env-file secrets.properties up -d).
# NO subir secrets.properties al repo.

# --- Base de datos ---
# DB_PORT: puerto del host donde se expone el PostgreSQL de compose.
# Si ya tienes un PostgreSQL nativo en 5432, usa otro (p. ej. 5433) y ajusta DB_URL.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/odontorisas
DB_NAME=odontorisas
# Credenciales del rol de APLICACIÓN (runtime). En despliegue debe ser un rol
# SOLO-DML y NO propietario de las tablas, para que Row-Level Security le aplique
# de forma ineludible. NUNCA debe ser SUPERUSER ni tener BYPASSRLS (saltan RLS).
DB_USERNAME=odontorisas
DB_PASSWORD=cambia-esta-clave

# --- Menor privilegio: rol de migraciones (Flyway/DDL, propietario de las tablas) ---
# Opcional. Si se omite, Flyway usa las mismas credenciales de la app (válido para
# desarrollo local con un único usuario). En despliegue define un rol admin separado
# y crea ambos roles con scripts/db-roles.sql.
# DB_ADMIN_USERNAME=odontorisas_admin
# DB_ADMIN_PASSWORD=cambia-esta-clave-admin

# --- Pool de conexiones (opcional) ---
# Por defecto el pool no retiene conexiones ni hace keepalive, para que la base pueda dormir
# (Neon). Los valores por defecto sirven en local y en despliegue; solo cámbialos si lo mides.
# DB_POOL_MIN_IDLE=0
# DB_POOL_IDLE_TIMEOUT_MS=60000
# DB_POOL_MAX_SIZE=5

# --- Actuator ---
# HEALTH_SHOW_DETAILS: detalle de /actuator/health (always por defecto). En DESPLIEGUE pon
# never: la ruta es pública y no debe publicar el estado de la base ni del disco.
# HEALTH_SHOW_DETAILS=never

# --- Documentación de la API (Swagger) ---
# SWAGGER_ENABLED: apagada por defecto. En LOCAL descomenta la línea de abajo para ver
# /swagger-ui.html y /v3/api-docs. En DESPLIEGUE déjala comentada o ausente: si copias este
# archivo tal cual, la documentación queda apagada.
# SWAGGER_ENABLED=true

# --- Seguridad / JWT ---
# JWT_SECRET: al menos 32 BYTES aleatorios (genera uno con: openssl rand -base64 48).
# La app NO arranca si falta, si es este valor de ejemplo o si tiene menos de 32 bytes.
# Sin openssl (Windows): node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
# Opcionales (tienen defaults en application.yml):
# JWT_ISSUER=odontorisas
# JWT_ACCESS_TTL=PT15M        # Duration ISO-8601 (access token en memoria)
# JWT_REFRESH_TTL=P7D         # Duration ISO-8601 (refresh en cookie httpOnly)
# REFRESH_COOKIE_NAME=refresh_token
# COOKIE_SECURE=true          # false para http en local si es necesario
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Bloqueo por intentos fallidos de login (opcionales, tienen defaults en application.yml) ---
# AUTH_LOCKOUT_MAX_ATTEMPTS=5     # intentos fallidos consecutivos antes de bloquear
# AUTH_LOCKOUT_WINDOW=PT15M       # Duration ISO-8601 (duración del bloqueo)

# --- Correo de invitaciones (SMTP; Brevo u otro proveedor) ---
# Sin MAIL_ENABLED=true toda invitación se rechaza con 503: el token solo viaja por correo.
# MAIL_PASSWORD es la clave SMTP del proveedor, NO la de tu buzón.
# MAIL_ENABLED=true
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario-smtp
# MAIL_PASSWORD=clave-smtp
# MAIL_FROM=no-reply@tu-dominio.com
# FRONTEND_URL=http://localhost:5173   # base del enlace que llega en el correo

# --- Correo LOCAL con Mailpit (solo desarrollo; docs/tooling-setup.md) ---
# Levanta Mailpit con el mismo `docker compose --env-file secrets.properties up -d` y descomenta este bloque
# (en lugar de MAIL_* del proveedor de arriba). Los correos se ven en http://localhost:8025.
# MAIL_LOCAL_SMTP=true quita STARTTLS y autenticación, y solo arranca con MAIL_HOST local (localhost,
# 127.0.0.1 o ::1): NUNCA lo definas en un despliegue.
# MAIL_PORT (al que conecta el backend) y MAILPIT_SMTP_PORT (el que publica Mailpit) deben coincidir.
# MAIL_ENABLED=true
# MAIL_LOCAL_SMTP=true
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@dentdesk.local
# MAILPIT_SMTP_PORT=1025
# MAILPIT_WEB_PORT=8025
# --- Bootstrap del administrador de plataforma (una sola vez; docs/deployment.md §11.1) ---
# Crea al arrancar el PLATFORM_ADMIN que da de alta clínicas. El correo es solo el usuario de login
# (no recibe nada) y no puede ser el de una cuenta de clínica. La clave va en claro: se guarda hasheada.
# Tras el primer arranque: pon ENABLED=false y BORRA la línea de PASSWORD.
# PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true
# PLATFORM_ADMIN_EMAIL=admin@dentdesk.local
# PLATFORM_ADMIN_FULL_NAME=Plataforma Dentdesk
# PLATFORM_ADMIN_PASSWORD=clave-larga-aleatoria
