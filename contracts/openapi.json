{
  "openapi": "3.0.3",
  "info": {
    "title": "OdontoRisas API",
    "description": "API de la clínica dental OdontoRisas",
    "version": "v1"
  },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "auth", "description": "Autenticación" }],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["auth"],
        "operationId": "register",
        "summary": "Registra una cuenta e inicia sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada; sesión iniciada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProblemDetail" },
          "409": { "$ref": "#/components/responses/ProblemDetail" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "login",
        "summary": "Inicia sesión con credenciales",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProblemDetail" },
          "401": { "$ref": "#/components/responses/ProblemDetail" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "operationId": "refresh",
        "summary": "Renueva el access token usando la cookie de refresco",
        "responses": {
          "200": {
            "description": "Sesión renovada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ProblemDetail" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "operationId": "logout",
        "summary": "Cierra la sesión e invalida el refresh token",
        "responses": {
          "204": { "description": "Sesión cerrada" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ProblemDetail": {
        "description": "Error en formato RFC 9457",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetail" }
          }
        }
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["id", "email", "role"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["accessToken", "user"],
        "properties": {
          "accessToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/UserResponse" }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "format": "int32" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri" },
          "timestamp": { "type": "string", "format": "date-time" },
          "traceId": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
