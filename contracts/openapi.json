  "components": {
    "schemas": {
      "UpdateBrandingRequest": {
        "type": "object",
        "properties": {
          "brandPrimary": {
            "type": "string",
            "example": "#7f1aa6",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "brandSecondary": {
            "type": "string",
            "example": "#16C3B2",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoUrl": {
            "type": "string",
