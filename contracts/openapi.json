{
  "openapi": "3.1.0",
  "info": {
    "title": "OdontoRisas API",
    "description": "API de la clínica dental OdontoRisas",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "organization-branding",
      "description": "Personalización visual por organización"
    },
    {
      "name": "auth",
      "description": "Autenticación"
    }
  ],
  "paths": {
    "/organizations/me/branding": {
      "get": {
        "tags": [
          "organization-branding"
        ],
        "operationId": "getBranding",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BrandingResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "organization-branding"
        ],
        "operationId": "updateBranding",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBrandingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BrandingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "refresh",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateBrandingRequest": {
        "type": "object",
        "properties": {
          "brandPrimary": {
            "type": "string",
            "example": "#7f1aa6",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "brandSecondary": {
            "type": "string",
            "example": "#16C3B2",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoUrl": {
            "type": "string",
            "example": "https://cdn.example.com/clinica/logo.png",
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "BrandingResponse": {
        "type": "object",
        "properties": {
          "brandPrimary": {
            "type": "string",
            "description": "Color primario de marca (hex), o null = default",
            "example": "#7f1aa6"
          },
          "brandSecondary": {
            "type": "string",
            "description": "Color secundario (hex), o null = derivado del primario",
            "example": "#16C3B2"
          },
          "logoUrl": {
            "type": "string",
            "description": "URL https del logo, o null = logo del producto",
            "example": "https://cdn.example.com/clinica/logo.png"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2
          }
        },
        "required": [
          "email",
          "fullName",
          "organizationName",
          "password"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "organizationId": {
            "type": "integer",
            "format": "int64"
          },
          "organizationName": {
            "type": "string"
          },
          "organizationSlug": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "fullName",
          "id",
          "organizationId",
          "organizationName",
          "organizationSlug",
          "role"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}
